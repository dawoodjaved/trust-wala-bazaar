// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
  SYSTEM
}

model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  email             String   @unique
  phone             String?
  firstName         String?
  lastName          String?
  avatar            String?
  role              UserRole @default(BOTH)
  
  // Verification
  cnicVerified      Boolean  @default(false)
  cnicNumber        String?
  cnicImage         String?
  videoVerified     Boolean  @default(false)
  videoUrl          String?
  verificationStatus VerificationStatus @default(PENDING)
  
  // Location
  city              String?
  province          String?
  address           String?
  latitude          Float?
  longitude         Float?
  
  // Stats
  rating            Float    @default(0)
  totalReviews      Int      @default(0)
  responseTime      Int?     // in minutes
  
  // Preferences
  language          String   @default("en")
  simpleMode        Boolean  @default(false)
  highContrast      Boolean  @default(false)
  fontSize          Int      @default(16)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  products          Product[]
  orders            Order[]
  messages          Message[]
  reviews           Review[]
  savedProducts     SavedProduct[]
  notifications     Notification[]
}

model Category {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  description       String?
  icon              String?
  image             String?
  parentId           String?
  parent            Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  products          Product[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String   @db.Text
  price             Float
  originalPrice     Float?
  condition         ProductCondition
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  sellerId          String
  seller            User     @relation(fields: [sellerId], references: [id])
  
  // Location
  city              String
  province          String
  latitude          Float?
  longitude         Float?
  
  // Media
  images            String[] // Array of image URLs
  videos            String[] // Array of video URLs
  thumbnail         String?
  
  // Specifications (JSON)
  specifications    Json?
  
  // Trust & Verification
  trustScore        Float    @default(0)
  ptaVerified       Boolean  @default(false)
  ptaStatus         String?
  
  // AI Features
  aiPriceSuggestion Float?
  aiPriceConfidence Float?
  ecoScore          Float?
  
  // Stats
  views             Int      @default(0)
  likes             Int      @default(0)
  isActive          Boolean  @default(true)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  orders            Order[]
  reviews           Review[]
  savedProducts     SavedProduct[]
  messages          Message[]
}

model Review {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user              User     @relation(fields: [userId], references: [id])
  sellerId           String
  
  rating            Int      // 1-5
  title             String?
  content           String   @db.Text
  pros              String[]
  cons              String[]
  
  // AI Aggregated
  aiSummary         String?  @db.Text
  isVerified        Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id])
  sellerId           String
  
  price             Float
  status            OrderStatus @default(PENDING)
  
  // Payment
  paymentMethod     String?
  paymentStatus     String?
  escrowEnabled     Boolean  @default(true)
  
  // Shipping
  shippingAddress   String?
  trackingNumber    String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  senderId          String
  sender            User     @relation(fields: [senderId], references: [id])
  receiverId        String
  
  type              MessageType @default(TEXT)
  content           String   @db.Text
  imageUrl          String?
  
  // Offer (if type is OFFER)
  offerPrice        Float?
  offerExpiresAt    DateTime?
  
  // AI Features
  aiTranslated      Boolean  @default(false)
  originalLanguage  String?
  translatedContent String? @db.Text
  
  isRead            Boolean  @default(false)
  readAt            DateTime?
  
  createdAt         DateTime @default(now())
}

model SavedProduct {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  
  @@unique([userId, productId])
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type              String
  title             String
  message           String   @db.Text
  link              String?
  
  isRead            Boolean  @default(false)
  readAt            DateTime?
  
  createdAt         DateTime @default(now())
}

model FlashDeal {
  id                String   @id @default(cuid())
  title             String
  description       String? @db.Text
  discountPercent   Float
  startDate         DateTime
  endDate           DateTime
  maxQuantity       Int?
  isActive          Boolean  @default(true)
  
  productIds        String[] // Array of product IDs
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Bundle {
  id                String   @id @default(cuid())
  title             String
  description       String? @db.Text
  bundlePrice       Float
  originalPrice     Float
  productIds        String[] // Array of product IDs
  isActive          Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

