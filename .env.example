# Copy to .env.local (and Vercel env). Never commit secrets.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty so the browser uses same-origin /api on Next.js
NEXT_PUBLIC_API_URL=

# Absolute URL for upload links (local or Vercel)
PUBLIC_API_URL=http://localhost:3010
FRONTEND_URL=http://localhost:3010

# AI — at least one
OPENAI_API_KEY=
GEMINI_API_KEY=

# Auth (optional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Durable uploads on Vercel (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
