# Copy to .env.local and fill in values. Never commit real secrets.

# --- App / API ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# --- Database (required for Nest backend / Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/trustwala_bazaar?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Optional — leave empty to use demo login
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI (optional — features degrade gracefully without keys) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Storage (optional — local uploads used if unset) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Maps use Leaflet + OpenStreetMap — no Google Maps key required
GOOGLE_MAPS_API_KEY=
