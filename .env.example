# Copy to .env.local (and Vercel env). Never commit real secrets.
# If any secret was previously hardcoded or committed, rotate it immediately.

# Required — strong random string, 32+ characters (weak defaults are rejected)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Leave empty so the browser uses same-origin /api on Next.js
NEXT_PUBLIC_API_URL=

# Absolute URL for upload links (local or Vercel)
PUBLIC_API_URL=http://localhost:3010
FRONTEND_URL=http://localhost:3010

# AI — at least one (server-side only; never NEXT_PUBLIC_*)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Auth (recommended for production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local demo login only — NEVER true in production
ALLOW_DEMO_AUTH=false

# Optional durable uploads
SUPABASE_URL=
SUPABASE_ANON_KEY=
